  <!-- ==================== MODAL DE MARCAÇÃO DIRETA ==================== -->
  <div id="booking-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-clandestina-card border border-clandestina-gold/30 rounded-2xl w-full max-w-lg p-6 md:p-8 relative shadow-2xl">
      
      <!-- Close Button -->
      <button onclick="closeBookingModal()" class="absolute top-6 right-6 text-gray-400 hover:text-white text-xl">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <span class="text-xs uppercase tracking-widest text-clandestina-gold font-bold block mb-1">Agendamento Fácil</span>
      <h3 class="font-serif text-2xl font-bold text-white uppercase mb-6">Reservar Horário</h3>

      <form id="booking-form" onsubmit="handleBookingSubmit(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-gray-300 font-semibold mb-1">Nome Completo</label>
          <input type="text" id="client-name" required placeholder="Ex: Diogo Silva" class="w-full bg-clandestina-dark border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-clandestina-gold">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-gray-300 font-semibold mb-1">Telemóvel</label>
            <input type="tel" id="client-phone" required placeholder="912 345 678" class="w-full bg-clandestina-dark border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-clandestina-gold">
          </div>
          <div>
            <label class="block text-gray-300 font-semibold mb-1">Serviço</label>
            <select id="client-service" class="w-full bg-clandestina-dark border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-clandestina-gold">
              <option value="Barba">Barba (14 €)</option>
              <option value="Corte Curto">Corte Curto (15 €)</option>
              <option value="Corte Longo">Corte Longo (20 €)</option>
              <option value="Barba & Corte" selected>Barba & Corte (24 €)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-gray-300 font-semibold mb-1">Dia Preferencial</label>
            <input type="date" id="client-date" required class="w-full bg-clandestina-dark border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-clandestina-gold">
          </div>
          <div>
            <label class="block text-gray-300 font-semibold mb-1">Hora Desejada</label>
            <input type="time" id="client-time" required class="w-full bg-clandestina-dark border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-clandestina-gold">
          </div>
        </div>

        <div class="pt-4">
          <button type="submit" class="w-full py-3.5 bg-clandestina-gold hover:bg-clandestina-goldLight text-black font-bold text-xs uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-clandestina-gold/20">
            <i class="fa-brands fa-whatsapp text-base"></i>
            <span>Confirmar via WhatsApp / Mensagem</span>
          </button>
          
          <a href="https://linktr.ee/Barbeariaclandestina" target="_blank" class="block text-center text-[11px] text-clandestina-muted hover:text-white mt-3 underline">
            Ou se preferires, acede ao link de agendamento online oficial
          </a>
        </div>
      </form>

    </div>
  </div>

  <!-- ==================== SCRIPTS ==================== -->
  <script>
    // Menu mobile toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });

    // Funções do Modal de Marcação
    const modal = document.getElementById('booking-modal');
    const serviceSelect = document.getElementById('client-service');

    function openBookingModal(serviceName = 'Geral') {
      if (serviceName && serviceName !== 'Geral') {
        for (let i = 0; i < serviceSelect.options.length; i++) {
          if (serviceSelect.options[i].value.includes(serviceName)) {
            serviceSelect.selectedIndex = i;
            break;
          }
        }
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeBookingModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Fechar ao clicar fora do modal
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeBookingModal();
    });

    // Animações ao scroll
    const revealElements = document.querySelectorAll('.reveal');

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -6% 0px'
    });

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });

    // Submissão do agendamento (Gera link formatado de WhatsApp)
    function handleBookingSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('client-name').value;
      const phone = document.getElementById('client-phone').value;
      const service = document.getElementById('client-service').value;
      const date = document.getElementById('client-date').value;
      const time = document.getElementById('client-time').value;

      const message = `Olá Barbearia Clandestina! Gostaria de agendar um horário:%0A%0A👤 *Nome:* ${encodeURIComponent(name)}%0A📱 *Contacto:* ${encodeURIComponent(phone)}%0A✂️ *Serviço:* ${encodeURIComponent(service)}%0A📅 *Data:* ${encodeURIComponent(date)}%0A⏰ *Hora:* ${encodeURIComponent(time)}%0A%0AFico a aguardar a vossa confirmação. Obrigado!`;

      // Se a barbearia tiver número WhatsApp, basta colocar o número aqui (ex: 351912345678)
      // Caso contrário, abre diretamente com a mensagem pré-preenchida
      window.open(`https://api.whatsapp.com/send?text=${message}`, '_blank');
      closeBookingModal();
    }
  </script>
</body>
</html>